{
  "network-header": {
    "type": "header",
    "description": "Network Monitoring"
  },
  "network-interface-picker": {
    "type": "custom",
    "file": "networkInterfaceChooser.py",
    "widget": "NetworkInterfaceChooser",
    "description": "Network interface"
  },
  "network-interface-mode": {
    "type": "generic",
    "default": "auto"
  },
  "custom-network-interface": {
    "type": "generic",
    "default": ""
  },
  "speed-test-header": {
    "type": "header",
    "description": "Internet Speed Test"
  },
  "speed-test-server": {
    "type": "combobox",
    "default": "auto",
    "description": "Speed test server",
    "options": {
      "Auto": "auto",
      "Los Angeles - Sharktech": "91",
      "Los Angeles - Clouvider": "54",
      "Las Vegas - Sharktech": "90",
      "Denver - Sharktech": "92",
      "Chicago - Sharktech": "93"
    }
  },
  "graph-header": {
    "type": "header",
    "description": "Live Traffic Graph"
  },
  "show-graph": {
    "type": "checkbox",
    "default": true,
    "description": "Show live traffic graph"
  },
  "graph-history-seconds": {
    "type": "spinbutton",
    "default": 60,
    "min": 15,
    "max": 300,
    "step": 15,
    "units": "seconds",
    "description": "Graph history"
  },
  "graph-height": {
    "type": "spinbutton",
    "default": 90,
    "min": 50,
    "max": 200,
    "step": 10,
    "units": "pixels",
    "description": "Graph height"
  }
}
